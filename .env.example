# Override the backend API base URL — useful for pointing the desktop app at
# a local pagedge-backend dev server. Defaults to the production deployment
# if unset.
VITE_PAGEDGE_API_URL=

# Sentry — client-side error reporting (unhandled exceptions, React render
# errors caught by ErrorBoundary). Leave unset to disable; the SDK no-ops
# without a DSN, so this is safe to leave blank on a fresh checkout.
VITE_SENTRY_DSN=
